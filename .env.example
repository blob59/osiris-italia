# ═══════════════════════════════════════════════════════════════════════════
#  OSIRIS Italia — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT
#  Never commit real API keys or secrets to GitHub. In production, configure
#  them in the hosting provider's Environment Variables / Secrets panel.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
#  PUBLIC SITE URL
#  Required for correct canonical/OpenGraph metadata in production.
#  Example: https://osiris.example.com
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────
#  LUMA AI — GEMINI
#  Luma reads Gemini keys only on the server through /api/ai/analyze.
#  Configure at least GEMINI_API_KEY_1 to enable Luma.
#  Up to 8 keys are supported and rotated by the existing backend.
#  Do NOT expose these as NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND
#  Powers the optional RECON toolkit. Leave both empty to disable it.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY.
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=

# ─────────────────────────────────────────────────────────────────────────
#  CLOUDFLARE RADAR
#  Optional. Enables Internet Outages and Attack Origins layers.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
#  CHAIN INTEL — OPTIONAL
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
HELIUS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS
# ─────────────────────────────────────────────────────────────────────────
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Without this key the live AIS ship cache remains unavailable, while static
# ports/chokepoints and the rest of the platform can still work.
AIS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
OSIRIS_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @).
# OSIRIS_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
